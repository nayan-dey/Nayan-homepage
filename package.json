{
  "name": "nayan-portfolio",
  "version": "2.0.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
